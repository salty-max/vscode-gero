{
  "comments": {
    "lineComment": "--"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "wordPattern": "(-?\\d+(?:\\.\\d+)?)|(@?[A-Za-z_][A-Za-z0-9_]*)",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:(?:local\\s+)?(?:bake\\s+)?(?:def|class|struct|enum)\\b|(?:if|elif|else|while|for|repeat|match|do)\\b|case\\b.*=>\\s*$|lambda\\b).*$",
    "decreaseIndentPattern": "^\\s*(?:end|else|elif|until|case)\\b"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*--.*$",
      "action": { "indent": "none", "appendText": "-- " }
    }
  ]
}

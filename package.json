{
  "name": "gero-asm",
  "displayName": "Gero Assembly",
  "description": "Syntax highlighting and editor support for the Gero VM assembly language (.gas).",
  "version": "0.4.0",
  "publisher": "salty-max",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "gero",
    "assembly",
    "vm",
    "asm",
    "gas"
  ],
  "homepage": "https://github.com/salty-max/gero",
  "repository": {
    "type": "git",
    "url": "https://github.com/salty-max/vscode-gero"
  },
  "bugs": {
    "url": "https://github.com/salty-max/gero/issues"
  },
  "license": "MIT",
  "contributes": {
    "languages": [
      {
        "id": "gero-asm",
        "aliases": [
          "Gero Assembly",
          "gero-asm"
        ],
        "extensions": [
          ".gas"
        ],
        "configuration": "./language-configurations/gero-asm.json"
      },
      {
        "id": "gero-lang",
        "aliases": [
          "gero-lang",
          "Gero"
        ],
        "extensions": [
          ".gr"
        ],
        "configuration": "./language-configurations/gero-lang.json"
      }
    ],
    "grammars": [
      {
        "language": "gero-asm",
        "scopeName": "source.gero-asm",
        "path": "./grammars/gero-asm.tmLanguage.json"
      },
      {
        "language": "gero-lang",
        "scopeName": "source.gero-lang",
        "path": "./grammars/gero-lang.tmLanguage.json"
      }
    ]
  }
}

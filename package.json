{
  "name": "gero-asm",
  "displayName": "Gero",
  "description": "Syntax highlighting, diagnostics and navigation for the Gero VM assembly language (.gas) and gero-lang (.gr).",
  "version": "0.5.0",
  "publisher": "salty-max",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "gero",
    "assembly",
    "vm",
    "asm",
    "gas"
  ],
  "homepage": "https://github.com/salty-max/gero",
  "repository": {
    "type": "git",
    "url": "https://github.com/salty-max/vscode-gero"
  },
  "bugs": {
    "url": "https://github.com/salty-max/gero/issues"
  },
  "license": "MIT",
  "contributes": {
    "languages": [
      {
        "id": "gero-asm",
        "aliases": [
          "Gero Assembly",
          "gero-asm"
        ],
        "extensions": [
          ".gas"
        ],
        "configuration": "./language-configurations/gero-asm.json"
      },
      {
        "id": "gero-lang",
        "aliases": [
          "gero-lang",
          "Gero"
        ],
        "extensions": [
          ".gr"
        ],
        "configuration": "./language-configurations/gero-lang.json"
      }
    ],
    "grammars": [
      {
        "language": "gero-asm",
        "scopeName": "source.gero-asm",
        "path": "./grammars/gero-asm.tmLanguage.json"
      },
      {
        "language": "gero-lang",
        "scopeName": "source.gero-lang",
        "path": "./grammars/gero-lang.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Gero",
      "properties": {
        "gero.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to the `gero` binary. Empty resolves `gero` on `PATH`."
        },
        "gero.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace the JSON-RPC conversation with the language server, in the Gero Language Server output channel."
        }
      }
    }
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:gero-asm",
    "onLanguage:gero-lang"
  ],
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.6.0"
  }
}
